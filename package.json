{
  "name": "@your-scope/sqlite-webworker",
  "version": "0.0.1",
  "type": "module",
  "files": ["dist"],
  "main": "./dist/sqlite-webworker.js",
  "module": "./dist/sqlite-webworker.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/sqlite-webworker.js"
    },
    "./db-worker": {
      "types": "./dist/db-worker.d.ts",
      "import": "./dist/db-worker.js"
    },
    "./db-core": {
      "types": "./dist/db-core.d.ts",
      "import": "./dist/db-core.js"
    }
  },
  "sideEffects": true,
  "scripts": {
    "dev": "vite --config vite.config.demo.ts",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:demo": "vite build --config vite.config.demo.ts",
    "preview": "vite preview --config vite.config.demo.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.51.2-build6",
    "comlink": "^4.4.2",
    "ulid": "^3.0.2"
  }
}
